---
import siteConfig from '@/config/site.config';
import { content } from '@/config/content';
import { locales } from '@/config/site.config';

const year = new Date().getFullYear();
const location = siteConfig.location;
---

<footer class="border-t border-border-strong py-8">
  <div class="container flex flex-col items-start justify-between gap-4 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-foreground-muted md:flex-row md:items-center">
    <div class="space-y-1">
      <p class="text-foreground">{siteConfig.personName ? siteConfig.personName.toUpperCase() : ''}</p>
      <p>
        {locales.map((locale) => (
          <span data-lang={locale}>
            {content.footer[locale].siteBy}{' '}
            <a href="https://hostesswebs.pl" target="_blank" rel="noopener noreferrer" class="text-foreground transition-colors hover:text-accent">
              hostesswebs.pl
            </a>
          </span>
        ))}
      </p>
    </div>
    <div class="space-y-1 md:text-right">
      <p>© {year} · {location}</p>
      {locales.map((locale) => (
        <p data-lang={locale}>{content.footer[locale].rights}</p>
      ))}
    </div>
    {locales.map((locale) => (
      <p data-lang={locale}>{content.footer[locale].tagline}</p>
    ))}
  </div>
</footer>
